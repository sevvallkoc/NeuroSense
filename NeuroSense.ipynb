plt.xlabel('Grafen katman sayisi')
plt.ylabel('Duyarlilik S (derece/RIU)')
plt.title('Figur 3 - Grafen katmani vs Duyarlilik')
plt.grid(True)
plt.savefig('figur3.png', dpi=150)
plt.show()

